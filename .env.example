APP_NAME=Laravel
APP_ENV=local

# Utenti demo del mock XD (password "password"): accesi fuori produzione.
# Su un'istanza pubblica lasciarli spenti, o accenderli consapevolmente.
SEED_DEMO_DATA=true
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=it
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# Mail — Mailgun (provider scelto dalla cliente, lug 2026), regione EU.
# In locale lasciare "log": le mail finiscono in storage/logs/laravel.log.
# In staging/produzione: MAIL_MAILER=smtp (oppure "mailgun" per l'API HTTP).
MAIL_MAILER=log
# smtp.eu.mailgun.org per la regione EU, smtp.mailgun.org per la US.
MAIL_HOST=smtp.eu.mailgun.org
# 587 STARTTLS (consigliata) — 2525 se l'hosting filtra la 587, 465 con MAIL_SCHEME=smtps.
MAIL_PORT=587
MAIL_SCHEME=smtp
# Credenziali SMTP del dominio Mailgun (Sending > Domain settings > SMTP credentials).
# NON sono la API key: username è tipo postmaster@mg.animalamo.it.
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_TIMEOUT=10
MAIL_FROM_ADDRESS="no-reply@mg.animalamo.it"
MAIL_FROM_NAME="${APP_NAME}"

# Solo per MAIL_MAILER=mailgun (transport API HTTP, niente porte SMTP in uscita).
# MAILGUN_DOMAIN è il sending domain (es. mg.animalamo.it), MAILGUN_SECRET la
# Sending API key. Endpoint: api.eu.mailgun.net (EU) / api.mailgun.net (US).
#
# REGIONE: un dominio creato nell'area EU non esiste sugli endpoint US e
# viceversa. Con l'endpoint sbagliato Mailgun risponde "Domain not found", che
# sembra un dominio mancante ed è invece la regione sbagliata. Il sandbox
# fornito con ogni account è SEMPRE US, anche se i domini custom sono EU.
#
# DEMO / STAGING senza dominio verificato (on-forge.com, lug 2026): usare il
# sandbox con il transport API — il sandbox non ha credenziali SMTP generate.
#   MAIL_MAILER=mailgun
#   MAILGUN_DOMAIN=sandboxXXXX.mailgun.org
#   MAILGUN_ENDPOINT=api.mailgun.net
#   MAIL_FROM_ADDRESS="postmaster@sandboxXXXX.mailgun.org"
# Il sandbox consegna SOLO agli "Authorized Recipients" (max 5), da aggiungere
# a mano nella dashboard Mailgun: non c'è endpoint API per gestirli. Verso un
# indirizzo non autorizzato l'invio fallisce con HTTP 403 "Sandbox subdomains
# are for test purposes only", non con un bounce silenzioso.
MAILGUN_DOMAIN=
MAILGUN_SECRET=
MAILGUN_ENDPOINT=api.eu.mailgun.net

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Stripe (carta, Apple Pay, Google Pay) — chiavi fornite dall'utente
STRIPE_KEY=
STRIPE_SECRET=
STRIPE_WEBHOOK_SECRET=

# Google Maps (Embed API) — mappa "Dove siamo" nelle pagine dettaglio
GOOGLE_MAPS_KEY=

# Iubenda — informativa cookie dei footer (default in config/services.php)
# IUBENDA_COOKIE_POLICY_URL=

